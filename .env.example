# 統計データ送信用の署名付き URL を発行する Worker のエンドポイント（未実装）
VITE_STATS_UPLOAD_ENDPOINT=
# R2 バケット名。S3 エンドポイントとアクセスキーは Worker のシークレットにだけ置き、クライアントへ渡さない
R2_BUCKET=bpim2cam
# メールでサインインするときの Turnstile のサイトキー（公開してよい識別子）。BPIM2 の NEXT_PUBLIC_TURNSTILE_SITE_KEY と同じ値。
# Turnstile の許可ホスト名に、このアプリのドメインを足すこと
VITE_TURNSTILE_SITE_KEY=
